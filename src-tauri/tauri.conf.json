{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SONORA AI",
  "version": "0.1.0",
  "identifier": "com.sonora.ai",
  "build": { "frontendDist": "../frontend/dist", "devUrl": "http://localhost:1420", "beforeDevCommand": "npm run dev --prefix ../frontend", "beforeBuildCommand": "npm run build --prefix ../frontend" },
  "app": { "windows": [{ "title": "SONORA AI", "width": 1280, "height": 800 }], "security": { "csp": "default-src 'self'; img-src 'self' blob: data: https:; media-src 'self' blob: https:; connect-src 'self' https: http://localhost:*" } },
  "bundle": {
    "active": true, "targets": "all", "icon": ["icons/128x128.png"],
    "android": { "minSdkVersion": 24 },
    "windows": { "nsis": true }, "linux": { "deb": true }, "macOS": { "dmg": true }
  },
  "plugins": { "sql": { "preload": [] } }
}
